{
	"activeGroups": ["auth", "api", "web"],
	"mocks": {
		"auth.local/login": {
			"variants": {
				"success": { "file": "./mocks/auth.local/login/success.json", "status": 200 },
				"invalid": { "file": "./mocks/auth.local/login/invalid.json", "status": 401 },
				"locked": { "file": "./mocks/auth.local/login/locked.json", "status": 423 }
			}
		},
		"api.local/users": {
			"variants": {
				"success": { "file": "./mocks/api.local/users/success.json", "status": 200 },
				"empty": { "file": "./mocks/api.local/users/empty.json", "status": 200 },
				"paginated": { "file": "./mocks/api.local/users/paginated.json", "status": 200 }
			}
		},
		"api.local/products": {
			"variants": {
				"catalog": { "file": "./mocks/api.local/products/catalog.json", "status": 200 },
				"empty": { "file": "./mocks/api.local/products/empty.json", "status": 200 }
			}
		}
	},
	"latency": { "globalMs": 0 }
}
